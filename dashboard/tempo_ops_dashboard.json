{
  "datasets": [
    {
      "name": "ds_sales",
      "displayName": "Sell-through",
      "queryLines": [
        "SELECT to_date(t.order_ts) AS sales_date, hour(t.order_ts) AS sales_hour, ",
        "       t.region AS region, t.province AS province, t.city AS city, ",
        "       t.division AS division, t.brand AS brand, t.category AS category, ",
        "       t.channel AS channel, t.status AS status, t.promo_flag AS promo_flag, ",
        "       t.units_ordered AS units_ordered, t.units_fulfilled AS units_fulfilled, ",
        "       t.net_idr AS net_idr, t.gross_idr AS gross_idr ",
        "FROM fact_sales t"
      ],
      "columns": [
        {"displayName": "Total Orders", "description": "Count of outlet orders", "expression": "COUNT(1)"},
        {"displayName": "Units Ordered", "description": "Total units ordered", "expression": "SUM(`units_ordered`)"},
        {"displayName": "Net Revenue Bn IDR", "description": "Net sell-through revenue in billions of IDR", "expression": "SUM(`net_idr`)/1000000000.0"},
        {"displayName": "Revenue At Risk Bn IDR", "description": "Net revenue on backorder/partial/cancelled orders (Bn IDR)", "expression": "SUM(CASE WHEN `status` IN ('backorder','partial','cancelled') THEN `net_idr` ELSE 0 END)/1000000000.0"},
        {"displayName": "Fill Rate", "description": "Units fulfilled / units ordered", "expression": "SUM(`units_fulfilled`)*1.0/NULLIF(SUM(`units_ordered`),0)"},
        {"displayName": "Stockout Order Rate", "description": "Backorder or partial orders / all orders", "expression": "SUM(CASE WHEN `status` IN ('backorder','partial') THEN 1 ELSE 0 END)*1.0/NULLIF(COUNT(1),0)"},
        {"displayName": "Cancellation Rate", "description": "Cancelled orders / all orders", "expression": "SUM(CASE WHEN `status`='cancelled' THEN 1 ELSE 0 END)*1.0/NULLIF(COUNT(1),0)"}
      ]
    },
    {
      "name": "ds_inventory",
      "displayName": "Inventory risk",
      "queryLines": [
        "SELECT to_date(i.reading_date) AS reading_date, i.dc_id AS dc_id, ",
        "       i.product_id AS product_id, p.product_name AS product_name, ",
        "       i.brand AS brand, i.division AS division, i.region AS region, ",
        "       i.on_hand_units AS on_hand_units, i.days_of_supply AS days_of_supply, ",
        "       i.days_to_expiry AS days_to_expiry, i.at_risk_expiry_units AS at_risk_expiry_units, ",
        "       i.avg_daily_demand AS avg_daily_demand, i.stockout_flag AS stockout_flag, ",
        "       i.expiry_risk_score AS expiry_risk_score ",
        "FROM fact_inventory i ",
        "LEFT JOIN dim_product p ON i.product_id = p.product_id"
      ],
      "columns": [
        {"displayName": "Readings", "description": "DC x product x day readings", "expression": "COUNT(1)"},
        {"displayName": "Stockout Rate", "description": "Share of DC-SKU-days in stockout", "expression": "SUM(`stockout_flag`)*1.0/NULLIF(COUNT(1),0)"},
        {"displayName": "Avg Days Of Supply", "description": "Average days of supply", "expression": "AVG(`days_of_supply`)"},
        {"displayName": "Avg Expiry Risk", "description": "Average expiry risk score (0-1)", "expression": "AVG(`expiry_risk_score`)"},
        {"displayName": "At Risk Expiry Units", "description": "Units exposed to expiry write-off", "expression": "SUM(`at_risk_expiry_units`)"},
        {"displayName": "SKUs At Expiry Risk", "description": "Distinct DC-SKU with expiry risk > 0.7", "expression": "COUNT(DISTINCT CASE WHEN `expiry_risk_score` > 0.7 THEN concat(`dc_id`,'|',`product_id`) END)"}
      ]
    },
    {
      "name": "ds_risk_worklist",
      "displayName": "At-risk SKU worklist",
      "queryLines": [
        "SELECT p.product_name AS product_name, i.brand AS brand, i.division AS division, ",
        "       i.dc_id AS dc_id, i.region AS region, ",
        "       i.expiry_risk_score AS expiry_risk_score, i.days_to_expiry AS days_to_expiry, ",
        "       i.at_risk_expiry_units AS at_risk_expiry_units, i.on_hand_units AS on_hand_units, ",
        "       i.days_of_supply AS days_of_supply ",
        "FROM fact_inventory i ",
        "LEFT JOIN dim_product p ON i.product_id = p.product_id ",
        "WHERE i.reading_date = (SELECT MAX(reading_date) FROM fact_inventory) ",
        "  AND i.expiry_risk_score > 0.7 ",
        "ORDER BY i.expiry_risk_score DESC LIMIT 50"
      ]
    },
    {
      "name": "ds_dc_map",
      "displayName": "DC demand & stockout",
      "queryLines": [
        "SELECT dc.dc_id AS dc_id, dc.dc_name AS dc_name, dc.city AS city, ",
        "       dc.region AS region, dc.lat AS lat, dc.lng AS lng, ",
        "       COALESCE(s.net_idr, 0) AS net_idr, COALESCE(s.units_ordered, 0) AS units_ordered, ",
        "       COALESCE(i.stockout_rate, 0) AS stockout_rate ",
        "FROM dim_distribution_center dc ",
        "LEFT JOIN (SELECT dc_id, SUM(net_idr) AS net_idr, SUM(units_ordered) AS units_ordered ",
        "           FROM fact_sales GROUP BY dc_id) s ON dc.dc_id = s.dc_id ",
        "LEFT JOIN (SELECT dc_id, SUM(stockout_flag)*1.0/NULLIF(COUNT(1),0) AS stockout_rate ",
        "           FROM fact_inventory GROUP BY dc_id) i ON dc.dc_id = i.dc_id"
      ]
    },
    {
      "name": "ds_forecast",
      "displayName": "National demand forecast",
      "queryLines": [
        "WITH actuals AS ( ",
        "  SELECT DATE_TRUNC('DAY', order_ts) AS sales_date, SUM(units_ordered) AS units ",
        "  FROM fact_sales ",
        "  WHERE DATE_TRUNC('DAY', order_ts) < DATE_TRUNC('DAY', current_timestamp()) ",
        "  GROUP BY 1 ",
        "), ",
        "dates AS (SELECT MAX(sales_date) AS max_d, MIN(sales_date) AS min_d FROM actuals), ",
        "forecast AS ( ",
        "  SELECT sales_date, units_forecast, units_upper, units_lower, CAST(NULL AS DOUBLE) AS units ",
        "  FROM AI_FORECAST( ",
        "    TABLE(actuals), ",
        "    horizon    => (SELECT max_d + MAKE_DT_INTERVAL(14, 0, 0, 0) FROM dates), ",
        "    time_col   => 'sales_date', ",
        "    value_col  => 'units', ",
        "    parameters => '{\"global_floor\": 0}' ",
        "  ) ",
        "), ",
        "bridge AS ( ",
        "  SELECT a.sales_date, ",
        "         CAST(a.units AS DOUBLE) AS units_forecast, ",
        "         CAST(a.units AS DOUBLE) AS units_upper, ",
        "         CAST(a.units AS DOUBLE) AS units_lower, ",
        "         CAST(a.units AS DOUBLE) AS units ",
        "  FROM actuals a JOIN dates d ON a.sales_date = d.max_d ",
        ") ",
        "SELECT sales_date, CAST(NULL AS DOUBLE) AS units_forecast, CAST(NULL AS DOUBLE) AS units_upper, CAST(NULL AS DOUBLE) AS units_lower, CAST(units AS DOUBLE) AS units FROM actuals ",
        "UNION ALL SELECT sales_date, units_forecast, units_upper, units_lower, units FROM bridge ",
        "UNION ALL SELECT sales_date, units_forecast, units_upper, units_lower, units FROM forecast"
      ]
    }
  ],
