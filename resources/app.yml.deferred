resources:
  apps:
    tempo_ops:
      name: tempo-scan-ops
      description: "Tempo Scan supply-chain operations — whitelabeled AppKit control center (Molecule to Shelf)"
      # This workspace enforces Git-backed app deploys, so the source is a Databricks
      # Git folder cloned from github.com/danteliew6/tempo-scan-ops (created via
      # `databricks repos create`). Pull the folder to update, then redeploy.
      source_code_path: /Workspace/Users/dante.liew@databricks.com/tempo-scan-ops-app
      user_api_scopes:
        - dashboards.genie
        - serving.serving-endpoints
      # Resources the app binds to, parameterized off the bundle variables so the
      # same app deploys against any workspace/target.
      resources:
        - name: sql-warehouse
          sql_warehouse:
            id: ${var.warehouse_id}
            permission: CAN_USE
        - name: genie-space
          genie_space:
            name: ${var.genie_space_name}
            # Bind to the DAB-managed Genie space (created by resources/genie.yml),
            # so replication is fully self-contained — no manual import/id wiring.
            space_id: ${resources.genie_spaces.tempo_genie.id}
            permission: CAN_RUN
        # NOTE: the serving-endpoint binding is intentionally omitted — on this workspace
        # the UC metastore is at its registered-model quota, so the demand/expiry models
        # can't be registered/served. gold_demand_forecast + gold_product_risk (the forecast
        # chart + risk worklist) are produced by the ML tasks regardless; only the optional
        # live "what-if" needs the endpoint. Re-add this block once a model slot is free:
        #   - name: serving-endpoint
        #     serving_endpoint: { name: ${var.serving_endpoint_name}, permission: CAN_QUERY }
        - name: postgres
          postgres:
            branch: ${var.lakebase_branch}
            database: ${var.lakebase_database}
            permission: CAN_CONNECT_AND_CREATE
